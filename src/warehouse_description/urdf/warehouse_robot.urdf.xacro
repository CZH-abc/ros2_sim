<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="warehouse_robot">
  <xacro:property name="body_l" value="0.60"/>
  <xacro:property name="body_w" value="0.45"/>
  <xacro:property name="body_h" value="0.25"/>
  <xacro:property name="wheel_r" value="0.08"/>
  <xacro:property name="wheel_w" value="0.04"/>
  <xacro:property name="wheel_track" value="0.50"/>
  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>
  <!-- 机器人主体 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${0.17 + body_h / 2.0}"/>
      <geometry>
        <box size="${body_l} ${body_w} ${body_h}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${0.17 + body_h / 2.0}"/>
      <geometry>
        <box size="${body_l} ${body_w} ${body_h}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${0.17 + body_h / 2.0}"/>
      <mass value="20.0"/>
      <inertia ixx="0.441667" ixy="0" ixz="0"
               iyy="0.704167" iyz="0"
               izz="0.937500"/>
    </inertial>
  </link>
  <!-- 左驱动轮 -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_r}" length="${wheel_w}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_r}" length="${wheel_w}"/>
      </geometry>
    </collision>
  <inertial>
  <origin xyz="0 0 0"/>
  <mass value="1.0"/>
  <inertia ixx="0.00173333" ixy="0" ixz="0"
           iyy="0.00173333" iyz="0"
           izz="0.0032"/>
  </inertial>
  </link>
  <gazebo reference="left_wheel_link">
  <material>Gazebo/Black</material>
  <mu1>1.5</mu1>
  <mu2>1.5</mu2>
  </gazebo>
  <joint name="left_wheel_joint"
         type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0.10 ${wheel_track / 2.0} 0.18"
            rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <!-- 右驱动轮 -->
  <link name="right_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="${wheel_r}" length="${wheel_w}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_r}" length="${wheel_w}"/>
      </geometry>
    </collision>
  <inertial>
  <origin xyz="0 0 0"/>
  <mass value="1.0"/>
  <inertia ixx="0.00173333" ixy="0" ixz="0"
           iyy="0.00173333" iyz="0"
           izz="0.0032"/>
  </inertial>
  </link>
  <gazebo reference="right_wheel_link">
  <material>Gazebo/Black</material>
  <mu1>1.5</mu1>
  <mu2>1.5</mu2>
  </gazebo>
  <joint name="right_wheel_joint"
         type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0.10 -${wheel_track / 2.0} 0.18"
            rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <!-- 支撑轮 -->
  <link name="caster_wheel_link">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
  <inertial>
  <origin xyz="0 0 0"/>
  <mass value="0.2"/>
  <inertia ixx="0.000128" ixy="0" ixz="0"
           iyy="0.000128" iyz="0"
           izz="0.000128"/>
  </inertial>
  </link>
  <gazebo reference="caster_wheel_link">
  <material>Gazebo/Black</material>
  <mu1>0.001</mu1>
  <mu2>0.001</mu2>
  </gazebo>
  <joint name="caster_wheel_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="-0.22 0 0.14"/>
  </joint>
  <!-- 激光雷达 -->
  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="laser_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.20 0 0.46"/>
  </joint>
  <!-- IMU -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.06 0.04 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <!-- 不写 inertial 时 Gazebo 按视觉体积+密度 1 推出 4.8e-5 kg，与 20 kg 车身差 40 万倍，
         这个 link 在物理引擎里等于不存在，IMU 传感器于是永远不发数据（发布者有、零帧） -->
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0000083" ixy="0" ixz="0"
               iyy="0.0000167" iyz="0"
               izz="0.0000217"/>
    </inertial>
  </link>
  <joint name="imu_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.30"/>
  </joint>

  <!-- Gazebo 不读 URDF 的 material，需要单独指定预置材质 -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="laser_link">
    <material>Gazebo/Red</material>
    <sensor name="warehouse_lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="warehouse_lidar_driver" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <material>Gazebo/Black</material>
    <sensor name="warehouse_imu" type="imu">
      <!-- SDF 里 always_on 默认 false，而 Gazebo 判断"有没有人订阅"只看它自己的 transport，
           ROS 2 插件的发布者不算数，于是传感器永不激活：发布者建好了却零帧 -->
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin name="warehouse_imu_driver" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- 差速驱动：订阅 cmd_vel，发布 odom 并广播 odom -> base_link -->
  <gazebo>
    <plugin name="warehouse_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>30.0</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_track}</wheel_separation>
      <wheel_diameter>${2 * wheel_r}</wheel_diameter>
      <max_wheel_torque>30.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>
</robot>